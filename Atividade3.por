programa {
  funcao inicio() {
    inteiro numeroA
    inteiro numeroB
    inteiro numeroC
    inteiro numeroD
    inteiro numeroE

     escreva ("me informe os 5 numeros \n")
      leia(numeroA)
       leia(numeroB)
        leia(numeroC)
         leia(numeroD)
          leia(numeroE)

     inteiro soma = numeroA + numeroB + numeroC + numeroD + numeroE
     inteiro media = soma / 5

    escreva ("A soma e de ", soma, " A media e de ", media)
  }
}
